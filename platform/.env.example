# Copy to .env and replace every value before starting the deployment.
DOMAIN=darkworld.website
POSTGRES_DB=namma_bill
POSTGRES_SUPERUSER=postgres
POSTGRES_ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_ADMIN_PASSWORD
APP_DB_USER=namma_bill
APP_DB_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_APP_PASSWORD
DATABASE_URL=postgresql://namma_bill:REPLACE_WITH_A_LONG_RANDOM_APP_PASSWORD@db:5432/namma_bill?schema=public
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
PROVISIONING_SECRET=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_SECRET
NODE_ENV=production
PORT=3000
GSTIN_PROVIDER_URL=
GSTIN_PROVIDER_TOKEN=
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
# Place trusted TLS certificate files at ./certs/fullchain.pem and ./certs/privkey.pem.
